{
  "name": "dothiscoach-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.site.config.js --host 127.0.0.1",
    "build:site": "vite build --config vite.site.config.js && node scripts/copy-static-site.mjs",
    "preview:site": "vite preview --config vite.site.config.js --host 127.0.0.1",
    "build:articles": "node scripts/build-articles.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:dist": "SITE_ROOT=dist node scripts/check-site.mjs",
    "check:experience": "node scripts/experience-contract-check.mjs",
    "lint:html": "html-validate index.html privacy.html terms.html support.html articles/index.html articles/*/index.html"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.182.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "html-validate": "^10.0.0",
    "vite": "^6.4.3"
  }
}
