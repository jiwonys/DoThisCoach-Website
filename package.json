{
  "name": "dothiscoach-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build:articles": "node scripts/build-articles.mjs",
    "check:site": "node scripts/check-site.mjs",
    "build:comparisons": "node scripts/build-comparisons.mjs",
    "build:site": "npm run build:css && npm run build:articles && npm run build:comparisons",
    "build:public": "npm run build:site && node scripts/build-public-site.mjs",
    "check:redesign": "node scripts/next-chapter-check.mjs",
    "build:css": "tailwindcss -i ./src/home.css -o ./home.css --minify",
    "dev": "node scripts/serve-preview.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "domutils": "^4.0.2",
    "htmlparser2": "^12.0.0",
    "lighthouse": "^12.8.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  }
}
